[general]
listen = "0.0.0.0:53"
protocol = "both4"
domain = "acme.{{ traefik_domain }}"
nsname = "ns-acme.{{ traefik_domain }}"
nsadmin = "admin.{{ traefik_domain }}"
records = [
    "acme.{{ traefik_domain }}. A {{ ansible_default_ipv4.address }}",
    "acme.{{ traefik_domain }}. NS ns-acme.{{ traefik_domain }}.",
]
debug = false

[database]
engine = "sqlite3"
connection = "/var/lib/acme-dns/acme-dns.db"

[api]
ip = "0.0.0.0"
port = "80"
tls = "none"
disable_registration = false
corsorigins = ["*"]
use_header = false
header_name = "X-Forwarded-For"

[logconfig]
loglevel = "info"
logtype = "stdout"
logformat = "text"
