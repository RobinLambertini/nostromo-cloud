services:
  prometheus:
    image: prom/prometheus:v3.15.0
    container_name: prometheus
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention }}
    volumes:
      - /home/nostromo/apps/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /home/nostromo/data/prometheus:/prometheus
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:9090/-/healthy"]
      interval: 1m
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - monitoring
      # Pour joindre l'entrypoint metrics de Traefik ; pas de label Traefik : Prometheus n'est pas exposé
      - traefik_public

  # Réseau et PID de l'hôte : sinon les stats réseau/processus seraient celles du conteneur
  node-exporter:
    image: prom/node-exporter:v1.12.1
    container_name: node-exporter
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ monitoring_gateway }}:9100
    volumes:
      - /:/host:ro,rslave

  cadvisor:
    image: ghcr.io/google/cadvisor:v0.60.6
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    devices:
      - /dev/kmsg
    command:
      - --docker_only=true
      - --housekeeping_interval=30s
      - --store_container_labels=false
      - --disable_metrics=advtcp,cpu_topology,cpuset,disk,hugetlb,memory_numa,percpu,perf_event,process,referenced_memory,resctrl,sched,tcp,udp
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    networks:
      - monitoring

  grafana:
    image: grafana/grafana:13.2.3
    container_name: grafana
    restart: unless-stopped
    depends_on:
      - prometheus
    env_file:
      - .env
    environment:
      GF_SERVER_ROOT_URL: https://grafana.{{ traefik_domain }}
      GF_SECURITY_ADMIN_USER: admin
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /etc/grafana/dashboards/infra.json
{% if grafana_oidc_client_id is defined %}
      # SSO Pocket ID : l'accès est filtré côté Pocket ID (groupes autorisés sur le client « Grafana »),
      # Grafana donne le rôle Admin au groupe grafana_oidc_admin_group, Viewer aux autres.
      # Le formulaire local reste actif (compte admin de secours si Pocket ID est indisponible)
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: Pocket ID
      GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP: "true"
      GF_AUTH_GENERIC_OAUTH_USE_PKCE: "true"
      GF_AUTH_GENERIC_OAUTH_SCOPES: openid email profile groups
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: https://auth.{{ traefik_domain }}/authorize
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: https://auth.{{ traefik_domain }}/api/oidc/token
      GF_AUTH_GENERIC_OAUTH_API_URL: https://auth.{{ traefik_domain }}/api/oidc/userinfo
      GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH: preferred_username
      GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH: email
      GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH: name
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "contains(groups[*], '{{ grafana_oidc_admin_group }}') && 'Admin' || 'Viewer'"
{% endif %}
    volumes:
      - /home/nostromo/data/grafana:/var/lib/grafana
      - /home/nostromo/apps/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
      - /home/nostromo/apps/monitoring/grafana/dashboards:/etc/grafana/dashboards:ro
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.grafana.rule=Host(`grafana.{{ traefik_domain }}`)"
      - "traefik.http.routers.grafana.entrypoints=websecure"
      - "traefik.http.routers.grafana.tls.certresolver=letsencrypt"
      - "traefik.http.services.grafana.loadbalancer.server.port=3000"
    networks:
      - monitoring
      - traefik_public

networks:
  monitoring:
    external: true
  traefik_public:
    external: true
