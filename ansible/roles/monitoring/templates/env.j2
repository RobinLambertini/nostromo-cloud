# Généré par Ansible depuis vault.yml : ne pas modifier à la main
# Valeurs entre apostrophes : prises telles quelles par Compose (pas d'interpolation des $), donc sans apostrophe dedans
# Le mot de passe admin n'est appliqué qu'au premier démarrage (création de la base Grafana)
GF_SECURITY_ADMIN_PASSWORD='{{ grafana_admin_password }}'
{% if grafana_oidc_client_id is defined %}
GF_AUTH_GENERIC_OAUTH_CLIENT_ID='{{ grafana_oidc_client_id }}'
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET='{{ grafana_oidc_client_secret }}'
{% endif %}
