services:
  pocket-id:
    image: ghcr.io/pocket-id/pocket-id:v2.19.1
    container_name: pocket-id
    restart: unless-stopped
    env_file:
      - .env
    environment:
      APP_URL: https://auth.{{ traefik_domain }}
      TRUST_PROXY: {{ traefik_public_subnet }}
      ANALYTICS_DISABLED: "true"
      DISABLE_LOCAL_LOGIN: "true"
      PUID: 1000
      PGID: 1000
    volumes:
      - /home/nostromo/data/pocket-id:/app/data
    healthcheck:
      test: ["CMD", "/app/pocket-id", "healthcheck"]
      interval: 1m30s
      timeout: 5s
      retries: 2
      start_period: 10s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.pocket-id.rule=Host(`auth.{{ traefik_domain }}`)"
      - "traefik.http.routers.pocket-id.entrypoints=websecure"
      - "traefik.http.routers.pocket-id.tls.certresolver=letsencrypt"
      - "traefik.http.services.pocket-id.loadbalancer.server.port=1411"
    networks:
      - traefik_public

networks:
  traefik_public:
    external: true
